# Cerebras API credentials for high-speed lyrics generation
CEREBRAS_API_KEY="your_cerebras_api_key"
CEREBRAS_MODEL="llama3.1-70b"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / PUBLIC_APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects APP_URL at runtime with the Cloud Run service URL.
# If configured, PUBLIC_APP_URL is used by Kie for webhook callback requests.
APP_URL="MY_APP_URL"
PUBLIC_APP_URL="https://meu-dominio.com"

# Treblo API credentials for AI music generation
TREBLO_API_KEY="your_treblo_api_key"
TREBLO_API_URL="https://api.treblo.com/v1"

# Kie.ai Suno API credentials for principal AI music generation
KIE_API_KEY="your_kie_api_key"
KIE_API_URL="https://api.kie.ai"

# Mercado Pago credentials for Pix payments (sandbox or production)
MERCADO_PAGO_ACCESS_TOKEN="your_mercado_pago_access_token"
MERCADO_PAGO_PUBLIC_KEY="your_mercado_pago_public_key"

# Supabase database credentials (optional fallback implemented)
SUPABASE_URL="your_supabase_url"
SUPABASE_KEY="your_supabase_key"
